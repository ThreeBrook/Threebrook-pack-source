#pragma code_page(65001)
// 由 src/viewer/CMakeLists.txt 生成：查看器的图标与界面资源。
// 图标：1 = 程序（资源管理器里 exe 的图标），2 = .iis 文件，3 = .iisz 包；安装包的文件关联用 iis-viewer.exe,-2 与 -3 引用后两个
1 ICON "@IIS_ICON_DIR@/iis-app.ico"
2 ICON "@IIS_ICON_DIR@/iis-file.ico"
3 ICON "@IIS_ICON_DIR@/iis-package.ico"
// 界面资源（theme.cpp 读取）：标题栏图标、三溪规范的字体（SIL OFL 1.1）
101 RCDATA "@IIS_ICON_DIR@/app-64.png"
102 RCDATA "@IIS_FONT_DIR@/ZCOOLXiaoWei-Regular.ttf"
103 RCDATA "@IIS_FONT_DIR@/BricolageGrotesque.ttf"
104 RCDATA "@IIS_FONT_DIR@/JetBrainsMono.ttf"

