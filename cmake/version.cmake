# Windows 程序版本信息：iis_version_info(目标 "说明")
# 版本号 = 工程版本（project VERSION）+ 第 4 段构建号 IIS_BUILD_NUMBER；公司名 IIS_COMPANY 由负责人定。
set(IIS_BUILD_NUMBER 0 CACHE STRING "版本号第 4 段（构建号），写入程序版本信息")
set(IIS_COMPANY "三溪 Threebrook" CACHE STRING "写入程序版本信息与安装包的公司名")
set(IIS_VERSION_RC_IN "${CMAKE_CURRENT_LIST_DIR}/version.rc.in")

function(iis_version_info target desc)
  if(NOT WIN32)
    return()
  endif()
  get_target_property(type ${target} TYPE)
  get_target_property(name ${target} OUTPUT_NAME)
  if(NOT name)
    set(name ${target})
  endif()
  if(type STREQUAL "SHARED_LIBRARY" OR type STREQUAL "MODULE_LIBRARY")
    set(IIS_FILE "${name}.dll")
    set(IIS_FTYPE "VFT_DLL")
  else()
    set(IIS_FILE "${name}.exe")
    set(IIS_FTYPE "VFT_APP")
  endif()
  set(IIS_NAME ${name})
  set(IIS_DESC "${desc}")
  set(IIS_V1 ${PROJECT_VERSION_MAJOR})
  set(IIS_V2 ${PROJECT_VERSION_MINOR})
  set(IIS_V3 ${PROJECT_VERSION_PATCH})
  set(IIS_V4 ${IIS_BUILD_NUMBER})
  set(out "${CMAKE_CURRENT_BINARY_DIR}/${target}_version.rc")
  configure_file("${IIS_VERSION_RC_IN}" "${out}" @ONLY)
  target_sources(${target} PRIVATE "${out}")
endfunction()
